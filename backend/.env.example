# ==============================================================================
# Database & Storage
# ==============================================================================
# Supabase PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
VECTOR_STORE=pgvector

# ==============================================================================
# Application & Security
# ==============================================================================
ENVIRONMENT=prod
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate_a_32_byte_base64_fernet_key_here

# Allowed origins for CORS (in single-project Vercel, requests are same-origin)
CORS_ORIGINS=["*"]

# ==============================================================================
# AI Models & Providers (Choose your preferred providers)
# ==============================================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# Alternative LLM Keys (if not using OpenAI):
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nl-db-platform

# ==============================================================================
# Frontend Environment (Vercel Production)
# ==============================================================================
# In a single Vercel project, the frontend and backend share the domain.
# Set this to /api/v1 (or leave empty to use default)
NEXT_PUBLIC_API_URL=/api/v1