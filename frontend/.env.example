# ==============================================================================
# Frontend Environment Variables
# ==============================================================================

# Backend API URL (Render backend URL or local development server)
# You can provide the base host (e.g. https://your-backend.onrender.com)
# or the full api path (e.g. https://your-backend.onrender.com/api/v1).
# Both formats are automatically normalized.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Application Branding
NEXT_PUBLIC_APP_NAME="NL-DB Query Platform"
